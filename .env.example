# OpenRouter API Key (for Gemini access via OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_openrouter_api_key_here

# Model Configuration (OpenRouter model identifier)
GEMINI_MODEL=google/gemini-2.5-flash

# Debug Mode (set to true to see tool calls and raw context in responses)
DEBUG_MODE=false

# Optional: Hugging Face API Configuration (legacy)
# HF_API_KEY=
# MODEL_NAME=HuggingFaceH4/zephyr-7b-beta

# Optional: Other configurations
# AGENT_PORT=8000
